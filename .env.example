# ─── AniMeal Environment Configuration ───────────────────────────
# Copy this file to .env and fill in real values.
# ⚠️  NEVER commit .env to Git — it is already in .gitignore.

# 1. Supabase Cloud Configuration (PostgreSQL + Auth + Storage)
# Get these from your Supabase Dashboard: https://supabase.com/dashboard
# Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. Gemini AI Configuration
# Server-side key (never exposed to browser)
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ⚠️  SECURITY WARNING: VITE_GEMINI_API_KEY is exposed in the browser JS bundle.
# Leave this BLANK in production — the Express proxy (/api/ai) uses GEMINI_API_KEY above.
# Only set this for local development as a fallback when the server is offline.
VITE_GEMINI_API_KEY=

# 3. AniMeal Express Backend Server Port (Default: 3001)
PORT=3001

# 4. Production Frontend URL (used for CORS whitelist on the Express server)
# Example: FRONTEND_URL=https://animeal.vercel.app
FRONTEND_URL=

# 5. Node Environment — set to production on hosting platforms (Vercel, Railway, etc.)
NODE_ENV=development
