# ─── AniMeal Environment Configuration ───────────────────────────

# 1. Supabase Cloud Configuration (PostgreSQL + Auth + Storage)
# Get these from your Supabase Dashboard: https://supabase.com/dashboard
# Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. Gemini AI Configuration (Client-side and Server-side)
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 3. AniMeal Express Backend Server Port (Default: 3001)
PORT=3001
